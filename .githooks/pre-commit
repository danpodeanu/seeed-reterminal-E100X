#!/bin/sh
# Refuse to commit an include/secrets.h. Real credentials must never
# reach version control; the file is .gitignored and each app builds
# from its include/secrets.h.example placeholder (copied at CI or
# local build time).
#
# Bypass with `git commit --no-verify` only if you have a very good
# reason.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)include/secrets\.h$' || true)
[ -z "$staged" ] && exit 0

printf '\npre-commit: refusing to commit include/secrets.h:\n' >&2
for f in $staged; do
  printf '  %s\n' "$f" >&2
done
printf 'These files are meant to hold private Wi-Fi / provider\n' >&2
printf 'credentials and are covered by .gitignore. If one is staged\n' >&2
printf 'you likely ran `git add -f` or edited an already-tracked copy.\n' >&2
printf 'Unstage with:\n' >&2
for f in $staged; do
  printf '  git reset HEAD %s\n' "$f" >&2
done
printf 'Emergency bypass: git commit --no-verify\n' >&2
exit 1

