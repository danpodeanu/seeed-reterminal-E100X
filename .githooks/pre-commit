#!/bin/sh
# Permit only the three tracked mock secrets headers. Each must remain
# byte-for-byte identical to its staged secrets.h.example counterpart.
# Other secrets headers and customized credentials must never be committed.
#
# Bypass with `git commit --no-verify` only if you have a very good
# reason.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)include/secrets\.h$' || true)
[ -z "$staged" ] && exit 0

invalid=""
for f in $staged; do
  case "$f" in
    xkcd-viewer/include/secrets.h|weather-viewer/include/secrets.h|photo-viewer/include/secrets.h)
      example="${f}.example"
      if ! git cat-file -e ":${example}" 2>/dev/null ||
         [ "$(git rev-parse ":${f}")" != "$(git rev-parse ":${example}")" ]; then
        invalid="${invalid}${f}
"
      fi
      ;;
    *)
      invalid="${invalid}${f}
"
      ;;
  esac
done

[ -z "$invalid" ] && exit 0

printf '\npre-commit: refusing non-mock include/secrets.h content:\n' >&2
printf '%s' "$invalid" | while IFS= read -r f; do
  [ -n "$f" ] && printf '  %s\n' "$f" >&2
done
printf 'Viewer secrets.h files must match secrets.h.example exactly;\n' >&2
printf 'all other secrets.h files must remain untracked.\n' >&2
exit 1
